rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The ERP stores tenant identities, invoices, payment slips and bank
    // reconciliation data. Never expose these collections to the public.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'p.ramajitti@gmail.com',
          'ramajitti.job@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /rooms/{id} {
      allow read, write: if isAdmin();
    }
    match /invoices/{id} {
      allow read, write: if isAdmin();
    }
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }
    match /settlements/{id} {
      allow read, write: if isAdmin();
    }
    match /settings/{id} {
      allow read, write: if isAdmin();
    }
    match /app_state/{id} {
      allow read, write: if isAdmin();
    }
    match /form_submissions/{id} {
      allow read, write: if isAdmin();
    }
    match /registrations/{id} {
      allow read, write: if isAdmin();
    }
    match /move_out_archives/{id} {
      allow read, write: if isAdmin();
    }
    match /backups/{id} {
      allow read, write: if isAdmin();
    }
  }
}
